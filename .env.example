# GridLens environment — copy to .env (which is gitignored).
#
# NOTE: AEMO public data needs NO API key, so the core pipeline runs with an
# empty .env. The values below are only for the Phase 6 Snowflake credibility
# run (a documented dbt build against Snowflake during its 30-day trial).

# --- Snowflake (Phase 6 only) -------------------------------------------
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=TRANSFORM
SNOWFLAKE_WAREHOUSE=GRIDLENS_WH
SNOWFLAKE_DATABASE=GRIDLENS
SNOWFLAKE_SCHEMA=ANALYTICS

# --- Ingestion (optional override) --------------------------------------
# Number of complete months of history to pull (default 36).
# GRIDLENS_HISTORY_MONTHS=36
