# Energy Grid Dashboard — environment. Copy to .env (which is gitignored).
#
# NOTE: AEMO public data needs NO API key, so the whole core pipeline runs with
# an empty .env. The values below are only for the optional Snowflake
# credibility run (see SNOWFLAKE.md) during Snowflake's 30-day trial.

# --- Snowflake (optional) -----------------------------------------------
# ACCOUNT: the account identifier, e.g. ABCDEFG-XY12345 (Snowsight -> account
#          menu -> "View account details" -> Account Identifier).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
# A fresh trial gives you ACCOUNTADMIN; swap for a lesser role if you make one.
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=GRIDLENS_WH
SNOWFLAKE_DATABASE=GRIDLENS
SNOWFLAKE_SCHEMA=ANALYTICS

# --- Ingestion (optional overrides) -------------------------------------
# Complete months of price & demand history to pull (default 72).
# GRIDLENS_HISTORY_MONTHS=72
# Months of per-DUID generation SCADA to pull (default 24).
# GRIDLENS_GENERATION_MONTHS=24
